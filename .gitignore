# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare local secrets and generated tooling
.dev.vars*
/.wrangler/
/.open-next/
/test-results/
/playwright-report/
*.key
*.p12
*.pfx

# Nested private guard Worker local tooling
**/.wrangler/

# Original public photos retained during asset optimization
/.asset-backups/
