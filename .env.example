# Local diagnostic tooling only; not used by the website intake.
DATABASE_URL=

# Public build variables. Keep demo mode until the version-2 form and activation gates are ready.
SITE_URL=
NEXT_PUBLIC_SECRET_KEY=0x4AAAAAAF4dkGJOJImddin9Y-f9IdETJhk
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF4dkM_EhEtHAXtf

# Server-only OAuth secrets. Set encrypted secrets in Cloudflare; never NEXT_PUBLIC_.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional verified US endpoint/layout overrides; wrong values fail closed. See docs/zoho-phase-b.md.
ZOHO_ACCOUNTS_URL=
ZOHO_API_DOMAIN=
ZOHO_CRM_LEADS_LAYOUT_ID=
ZOHO_CRM_SERVICE_APPOINTMENTS_LAYOUT_ID=
ZOHO_DESK_API_BASE=
ZOHO_DESK_ORG_ID=
ZOHO_DESK_DEPARTMENT_ID=

# Leads/Desk require explicit activation. Service defaults to appointment in Phase B;
# set disabled to turn it off. Global demo and protection/credential gates still apply.
ZOHO_ENABLE_CRM_LEADS=
ZOHO_SERVICE_MODE=
ZOHO_SUPPORT_MODE=
ZOHO_WORKING_WEEKDAYS=
ZOHO_HOLIDAYS=

# Required server-side anti-abuse and approved consent configuration.
TURNSTILE_SECRET_KEY=
ENQUIRY_ALLOWED_ORIGINS=
ENQUIRY_TURNSTILE_ACTION=
ENQUIRY_CONSENT_VERSION=
ENQUIRY_CONSENT_TEXT=
ENQUIRY_GUARD_SECRET=

# Cloudflare bindings (configure as resources, not string variables):
# ENQUIRY_GUARD: private rate/idempotency service binding.
# ZOHO_TOKEN_CACHE: optional private KV binding containing short-lived access tokens only.

# Phase B: verified optional strict overrides (server only)
ZOHO_CRM_API_VERSION=
ZOHO_CRM_LEAD_ASSIGNMENT_RULE_ID=
# Public, approved build-time UI configuration. Never put secrets here.
NEXT_PUBLIC_ENQUIRY_TURNSTILE_ACTION=
NEXT_PUBLIC_ENQUIRY_CONSENT_VERSION=
NEXT_PUBLIC_ENQUIRY_CONSENT_TEXT_EN=
NEXT_PUBLIC_ENQUIRY_CONSENT_TEXT_AR=

# Approved Arabic wording; English uses ENQUIRY_CONSENT_TEXT. Must match public wording.
ENQUIRY_CONSENT_TEXT_AR=

# Only needed for a deliberately selected Lead fallback; must match server route flags.
NEXT_PUBLIC_ENQUIRY_SERVICE_MODE=
NEXT_PUBLIC_ENQUIRY_SUPPORT_MODE=
