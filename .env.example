# Copy this file to .env and replace placeholders with local development values.
# Never commit real credentials. URL-encode special characters in passwords.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/autoflow_gcc?schema=public"

# Future Zoho integration; leave unset until access is provided.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=
ZOHO_API_BASE_URL=

# Optional public canonical origin. Set to the verified domain before publishing.
SITE_URL=
