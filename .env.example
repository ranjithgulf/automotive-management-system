# No environment variables are required to run the starter.
# Copy this file to .env.local when server-side integrations are added.
# Future Zoho credentials (leave unset until integration is implemented):
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=
# ZOHO_API_BASE_URL=
# Never prefix secrets with NEXT_PUBLIC_ or commit .env.local.
