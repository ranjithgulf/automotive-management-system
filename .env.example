# Copy this file to .env and replace placeholders with local development values.
# Never commit real credentials. URL-encode special characters in passwords.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/autoflow_gcc?schema=public"

# Future Zoho integration; leave unset until access is provided.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=
ZOHO_API_BASE_URL=

# Optional public canonical origin, never a credential or URL containing a path.
# Leave blank until Cloudflare provides the actual Pages deployment URL.
# Then set that verified HTTPS origin in the Pages build environment and rebuild.
# Replace it with the custom domain only after that domain is confirmed.
SITE_URL=
